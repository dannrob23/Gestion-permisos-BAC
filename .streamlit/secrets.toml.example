# Plantilla de secretos locales.
# Copia este archivo como .streamlit/secrets.toml y coloca los valores reales.
# .streamlit/secrets.toml está excluido de Git: nunca lo subas al repositorio.

# ---------- Supabase (base central) ----------
# Project URL y claves desde Supabase → Project Settings → API.
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"

# Clave publica "anon": permite solo lectura. Puede estar en el navegador.
SUPABASE_KEY = "COLOCA_AQUI_LA_CLAVE_ANON"

# Clave "service_role": permite escribir. NUNCA la publiques ni la pongas en
# el codigo; solo en este archivo local y en Streamlit Cloud → Settings → Secrets.
SUPABASE_SERVICE_KEY = "COLOCA_AQUI_LA_CLAVE_SERVICE_ROLE"

# ---------- GitHub (modo anterior, opcional) ----------
# Ya no es necesario si Supabase está configurado.
# GITHUB_TOKEN = "COLOCA_AQUI_TU_TOKEN"

# ---------- Contraseña opcional de la consulta ----------
# [consulta]
# password = "COLOCA_AQUI_LA_CLAVE_SI_APLICA"

# ---------- Contraseña del modo administrador ----------
# [admin]
# password = "COLOCA_AQUI_LA_CLAVE_ADMIN"
